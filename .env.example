# Required server-only core values. Generate a unique, high-entropy AUTH_SECRET.
DATABASE_URL=
AUTH_SECRET=
APP_URL=http://localhost:3000

# Disabled by default. "fixture" is for local deterministic testing only.
DATA_MODE=disabled
EMAIL_PROVIDER=disabled

# Required only when DATA_MODE=live; never expose as NEXT_PUBLIC_*.
NEBULA_API_KEY=

# Conditional email credentials; use one provider when email is implemented.
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Production only: bearer token for the weekly catalog cron (/api/v1/cron/catalog).
CRON_SECRET=
